VERSION=stable

COMPOSE_PROJECT_NAME=testcenter

# Ingress
HOSTNAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
# Strict-Transport-Security response header
HSTS_ENABLED=true

# TLS Certificates Resolvers
## Choose '', if you handle certificates manually, or
## choose 'acme', if you want to use an ACME provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER=
TLS_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
TLS_ACME_EAB_KID=
TLS_ACME_EAB_HMAC_ENCODED=
TLS_ACME_EMAIL=admin.name@organisation.org

# Images
## Dockerhub Proxy
DOCKERHUB_PROXY=
## Container Restart Policy. Allowed values are: no, always (default), on-failure, unless-stopped
RESTART_POLICY=always

# Services
## Backend
BROADCASTER_ENABLED=true
FILE_SERVER_ENABLED=true
### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by
### spaces. Empty disables the protection.
### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a
### TLS-terminating proxy), otherwise the protected logins are impossible.
BRUTE_FORCE_PROTECTION=
### Validate uploaded XML files against their XSD schema. Default is true.
XML_SCHEMA_VALIDATION=true
PASSWORD_SALT=t
SERVER_KEY=Secret
PASSWORD_MIN_LENGTH=7
PASSWORD_PATTERN=^.*$
## Refuse logins without password (except sys-check logins) and report them as errors in Testtakers files
REQUIRE_LOGIN_PASSWORD=false
ADMIN_INIT_PASSWORD=user123

## Storage
### Where the backend keeps the files of the workspaces: filesystem (in the volume backend_vol) or s3 (a bucket of an
### S3-compatible service, e.g. AWS, STACKIT or SeaweedFS). Choose it when installing: files already stored stay
### where they are, and the Testcenter does not find them after a switch.
STORAGE_DRIVER=filesystem
### --- the following apply only when STORAGE_DRIVER=s3 ---
### Address of the S3 API as the backend reaches it, without the bucket. Empty for AWS.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
### true: the bucket is part of the path (https://<endpoint>/<bucket>/...), false: a subdomain
### (https://<bucket>.<endpoint>/...).
S3_USE_PATH_STYLE=false
### Address of the S3 API as browsers reach it, if it differs from S3_ENDPOINT. Test-takers' browsers load the
### files of the tests from there.
S3_PUBLIC_ENDPOINT=
### Origin browsers load the files from, allowed in the Content Security Policy of the frontend. Only needed if it
### differs from S3_PUBLIC_ENDPOINT (or S3_ENDPOINT): with S3_USE_PATH_STYLE=false it is
### https://<bucket>.<endpoint host>, at AWS https://<bucket>.s3.<region>.amazonaws.com.
S3_PUBLIC_ORIGIN=
### Browsers get links to the files that stay the same for this many seconds, so they can cache the files.
### Default is 3600, at most 604500.
S3_URL_RENEWAL_INTERVAL=3600

## Cache Service
REDIS_PASSWORD=change_me
### Allowed memory usage for cache in byte. 2147483648 = 2GB. Default is 1GB.
REDIS_MEMORY_MAX=1gb
### Should whole files be cached or only authentication tokens
REDIS_CACHE_FILES=false

## Database
DB_DATABASE=iqb_tba_testcenter
DB_USER=iqb_tba_db_user
DB_PASSWORD=iqb_tba_db_password

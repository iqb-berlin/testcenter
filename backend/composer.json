{
  "_comment": "Mago (static analysis) is not installed via Composer but pinned in backend/Dockerfile. Update it there along with the dependencies.",
  "name": "iqb/testcenter-backend",
  "description": "IQB-Testcenter (Backend)",
  "homepage": "https://iqb-testcenter.de",
  "type": "project",
  "support": {
    "issues": "https://github.com/iqb-berlin/testcenter/issues",
    "docs": "https://pages.cms.hu-berlin.de/iqb/testcenter/"
  },
  "license": "MIT",
  "require": {
    "php": "^8.3.12",
    "php-di/php-di": "^6.4.0",
    "slim/http": "^1.4.0",
    "slim/psr7": "^1.8.0",
    "slim/slim": "^4.15.3",
    "tecnickcom/tcpdf": "^6.11.4",
    "ext-apache": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "ext-simplexml": "*",
    "ext-xmlreader": "*",
    "ext-zip": "*",
    "ext-zend-opcache" : "*",
    "ext-ctype": "*",
    "altcha-org/altcha": "^1.3.3",
    "async-aws/s3": "^3.5.0"
  },
  "require-dev": {
    "amphp/parallel": "^2.4.0",
    "mikey179/vfsstream": "^1.6.12",
    "phpunit/phpunit": "^10.5.66",
    "mockery/mockery": "^1.6.15",
    "ext-pcntl" : "*"
  },
  "autoload": {
    "classmap": ["src"]
  },
  "autoload-dev": {
    "classmap": ["test/unit/test-helper"]
  }
}

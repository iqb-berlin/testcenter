COMPOSE_PROJECT_NAME=testcenter-dev

# Ingress
HOSTNAME=localhost
HTTP_PORT=80
# Strict-Transport-Security response header
HSTS_ENABLED=true

# Images
## Dockerhub Proxy
DOCKERHUB_PROXY=
## Container Restart Policy. Allowed values are: no, always (default), on-failure, unless-stopped
RESTART_POLICY=no

# Services
## Backend
BROADCASTER_ENABLED=true
FILE_SERVER_ENABLED=true
BRUTE_FORCE_PROTECTION=
### Validate uploaded XML files against their XSD schema. Default is true.
XML_SCHEMA_VALIDATION=true

### Security
PASSWORD_SALT=t
PASSWORD_MIN_LENGTH=7
PASSWORD_PATTERN=^.*$
REQUIRE_LOGIN_PASSWORD=false
ADMIN_INIT_PASSWORD=user123
SERVER_KEY=Secret

### Init Parameters
#### These parameters may be used for additional init options of the backend.
#### Setting OVERWRITE_INSTALLATION to "yes" overwrites the existing installation.
#### Default value is "no", which means that existing installation will not be overwritten
OVERWRITE_INSTALLATION="no"
#### Setting SKIP_READ_FILES to "yes" skips the reading of file during start-up.
#### Default value is "no"", which means that all files will be read and checked on start-up.
SKIP_READ_FILES="no"
#### Setting SKIP_DB_INTEGRITY to "yes" skips the database integrity check during start-up.
#### Default value is "no", which means that the database integrity will be checked on start-up.
SKIP_DB_INTEGRITY="no"
#### Setting NO_SAMPLE_DATA to "yes" will not create a sample workspace.
#### Default value is "no", which means that a sample workspace with sample data will be created.
NO_SAMPLE_DATA="no"

### Object Storage (S3-compatible: SeaweedFS / AWS S3 / STACKIT)
#### By default the backend stores workspace files on the local filesystem
#### (STORAGE_DRIVER=filesystem). Set STORAGE_DRIVER=s3 to store them in an
#### S3-compatible bucket instead and serve them via presigned-URL redirects.
####
#### For local development the dev stack can run its own S3 (SeaweedFS): setting
#### STORAGE_DRIVER=s3 below is enough, `make up`/`make init-backend` start it
#### along with everything else — no separate switch to flip. (Using
#### `docker compose` directly instead of `make` needs `--profile s3` added by
#### hand.) The defaults here then work as-is: the bucket is created on
#### startup, the container reuses the S3_ACCESS_KEY/S3_SECRET_KEY set here,
#### and every origin is allowed so the presigned-URL redirects work in the
#### browser. Its Admin UI at http://localhost:23646 lets you browse the
#### bucket contents.
####
#### To use an external S3 instead (AWS, STACKIT, ...), point the S3_* vars at
#### it — the local SeaweedFS still starts alongside but sits unused, since
#### nothing here can tell "s3 pointed locally" from "s3 pointed externally"
#### apart. Stop it with `docker compose stop seaweedfs` if that's unwanted.
#### External buckets need a CORS rule allowing http://localhost, which the
#### bundled SeaweedFS does not require.
STORAGE_DRIVER=filesystem
#### --- the following apply only when STORAGE_DRIVER=s3 ---
#### Internal endpoint the backend/file-server use to reach the S3 service
#### (the bundled SeaweedFS service, or your external S3 URL).
S3_ENDPOINT=http://seaweedfs:8333
#### Browser-facing endpoint the presigned URL is SIGNED against. Must be
#### reachable from your browser; with SeaweedFS published on :8333 use localhost.
S3_PUBLIC_ENDPOINT=http://localhost:8333
#### S3 region. Any value for SeaweedFS; the real region for AWS/STACKIT.
S3_REGION=us-east-1
#### Bucket that holds the workspace files (created on startup by the bundled
#### SeaweedFS; create it yourself for AWS/STACKIT).
S3_BUCKET=tc-files
#### Path-style addressing. true for SeaweedFS/STACKIT, false for AWS.
S3_USE_PATH_STYLE=true
#### Use TLS for the internal endpoint. false for local http SeaweedFS.
S3_USE_SSL=false
#### Lifetime of presigned download URLs, in seconds.
S3_PRESIGN_TTL=3600
#### Credentials. The bundled SeaweedFS is started with exactly these, so they
#### are a free choice locally; for AWS/STACKIT use the real ones.
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
#### File-server toggle: serve via presigned-URL redirect instead of the local
#### data volume. Set to "true" together with STORAGE_DRIVER=s3.
OBJECT_STORE_ENABLED=false
#### FQDN the file-server uses to reach the backend for presign subrequests.
BACKEND_URL=http://backend:8080

## Cache Service
REDIS_PASSWORD=change_me
### Allowed memory usage for cache in byte. 2147483648 = 2GB. Default is 1GB.
REDIS_MEMORY_MAX=1gb
### Should whole files be cached or only authentication tokens
REDIS_CACHE_FILES=false

## Database
DB_DATABASE=iqb_tba_testcenter
DB_USER=iqb_tba_db_user
DB_PASSWORD=iqb_tba_db_password

# Network
## MTU Setting. Default is 1500, but Openstack actually uses 1442
DOCKER_DAEMON_MTU=1500
